{
  "name": "jwt-auth-q2",
  "version": "1.0.0",
  "description": "Lab 19 - Q2: Token based authentication with JWT and Prisma (register, login, protected route)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --watch src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --verbose",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:push": "prisma db push"
  },
  "keywords": [
    "jwt",
    "authentication",
    "express",
    "bcrypt",
    "prisma"
  ],
  "license": "ISC",
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1"
  }
}
